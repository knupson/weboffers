{
  "name": "weboffers",
  "compatibility_date": "2026-10-29",
  "main": "src/worker/index.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ofertas.knunet.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
