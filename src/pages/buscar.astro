---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import { amazonSearchUrl, ML_AFFILIATE, SEARCHES } from "../config";
import { loadProducts } from "../lib/data";

const { products } = await loadProducts();
const shown = products.filter((p) => p.verified);
// Texto en el que se busca: sin tildes y en minúsculas, igual que la consulta.
const norm = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const amazonBase = amazonSearchUrl("", "US");
// Búsquedas sugeridas con link oficial de afiliado de Mercado Libre.
const mlOficial = Object.fromEntries(SEARCHES.filter((s) => s.ml).map((s) => [s.term, s.ml]));
---

<Base title="Buscar y comparar" description="Buscá un producto y te decimos si conviene traerlo de Amazon o comprarlo en Mercado Libre.">
  <meta name="robots" content="noindex" slot="head" />
  <div class="wrap page-head">
    <h1 class="letra">Buscar y comparar</h1>
    <form class="search" action="/buscar/" method="get" role="search">
      <Icon name="magnifying-glass" size={18} />
      <input name="q" type="search" placeholder="SSD, Ryzen, auriculares, Garmin..." aria-label="Qué producto buscás" required />
      <button class="btn" type="submit">Comparar</button>
    </form>
    <p class="lead" id="resumen" aria-live="polite"></p>
  </div>

  <section style="padding-top: 0">
    <div class="wrap">
      <div class="grid-products" id="resultados">
        {shown.map((p) => (
          <div class="hit" hidden data-q={norm(`${p.name} ${p.brand} ${p.category} ${p.summary} ${p.slug.replace(/-/g, " ")}`)}>
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <div class="afuera" id="ml-vivo" hidden>
        <h2 class="letra">En Mercado Libre ahora</h2>
        <p class="ml-estado" id="ml-estado" aria-live="polite">Buscando en Mercado Libre…</p>
        <ul class="ml-lista" id="ml-lista"></ul>
        <p class="ml-nota">Para saber si conviene traerlo, pegá el precio de Amazon en la <a class="link" href="/calculadora/">calculadora</a>.</p>
      </div>

      <div class="afuera" id="afuera" hidden>
        <h2 class="letra">Seguí buscando en las tiendas</h2>
        <p>Si no está en nuestra lista, compará vos: mirá el precio en Mercado Libre y pegá el de Amazon en la <a class="link" href="/calculadora/">calculadora</a> para ver cuánto te sale puesto en tu casa.</p>
        <div class="tiendas">
          <a class="btn ml" id="ir-ml" href="https://listado.mercadolibre.com.ar/" target="_blank" rel="noopener noreferrer sponsored" data-umami-event="mercadolibre" data-umami-event-origen="busqueda">Buscar en Mercado Libre <Icon name="arrow-up-right" size={16} /></a>
          <a class="btn" id="ir-amazon" href={amazonBase} target="_blank" rel="noopener noreferrer sponsored" data-umami-event="amazon" data-umami-event-tienda="US" data-umami-event-origen="busqueda">Buscar en Amazon <Icon name="arrow-up-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ amazonBase, ml: ML_AFFILIATE, mlOficial }}>
    const q = (new URLSearchParams(location.search).get("q") || "").trim();
    const input = document.querySelector('input[name="q"]');
    if (input) input.value = q;
    const norm = (t) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    const tokens = norm(q).split(/\s+/).filter(Boolean);
    let n = 0;
    document.querySelectorAll(".hit").forEach((el) => {
      const ok = tokens.length > 0 && tokens.every((t) => el.dataset.q.includes(t));
      el.hidden = !ok;
      if (ok) n++;
    });
    const resumen = document.getElementById("resumen");
    resumen.textContent = !q ? "Escribí qué producto buscás." : n ? "Tenemos " + n + " " + (n === 1 ? "producto comparado" : "productos comparados") + ' para "' + q + '".' : 'No tenemos "' + q + '" comparado todavía.';
    if (q) {
      document.getElementById("afuera").hidden = false;
      const a = new URL(amazonBase);
      a.searchParams.set("k", q);
      document.getElementById("ir-amazon").href = a.toString();
      // Las búsquedas sugeridas tienen link oficial; para el resto, la etiqueta de afiliado va en la URL.
      const m = new URL("https://listado.mercadolibre.com.ar/" + encodeURIComponent(q.replace(/\s+/g, "-")));
      m.searchParams.set("matt_word", ml.word);
      m.searchParams.set("matt_tool", ml.tool);
      document.getElementById("ir-ml").href = mlOficial[q.toLowerCase()] || m.toString();
      // Con pocos resultados en el catálogo, se busca en vivo en Mercado Libre.
      if (n < 3) buscarEnMercadoLibre(q);
    }

    // Mercado Libre en vivo: si falla o no trae nada, se oculta la sección y queda el bloque "Seguí buscando".
    function buscarEnMercadoLibre(texto) {
      const seccion = document.getElementById("ml-vivo");
      const estado = document.getElementById("ml-estado");
      const lista = document.getElementById("ml-lista");
      const pesos = new Intl.NumberFormat("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 });
      seccion.hidden = false;
      estado.hidden = false;
      estado.textContent = "Buscando en Mercado Libre…";
      lista.replaceChildren();
      fetch("/api/buscar?q=" + encodeURIComponent(texto))
        .then((res) => {
          if (!res.ok) throw new Error("HTTP " + res.status);
          return res.json();
        })
        .then((data) => {
          const results = (data && Array.isArray(data.results) ? data.results : []).filter(
            (r) => r && typeof r.name === "string" && typeof r.price === "number" && Number.isFinite(r.price) && typeof r.url === "string" && r.url.startsWith("https://www.mercadolibre.com.ar/"),
          );
          if (!results.length) {
            seccion.hidden = true;
            return;
          }
          for (const r of results) {
            const li = document.createElement("li");
            li.className = "ml-item";
            const nombre = document.createElement("span");
            nombre.className = "ml-nombre";
            nombre.textContent = r.name;
            const precio = document.createElement("span");
            precio.className = "ml-precio num";
            precio.textContent = pesos.format(r.price);
            const boton = document.createElement("a");
            boton.className = "btn ml";
            boton.href = r.url;
            boton.target = "_blank";
            boton.rel = "noopener noreferrer sponsored";
            boton.dataset.umamiEvent = "mercadolibre";
            boton.dataset.umamiEventOrigen = "busqueda-vivo";
            boton.textContent = "Ver en Mercado Libre";
            li.append(nombre, precio, boton);
            lista.append(li);
          }
          estado.hidden = true;
        })
        .catch(() => {
          seccion.hidden = true;
          lista.replaceChildren();
        });
    }
  </script>
</Base>
