---
import Base from "../../layouts/Base.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../config";
import { guiasPublicables, loadGuias, linkify } from "../../lib/guias";
import { isComparable, loadProducts, MIN_AMAZON_SAVING } from "../../lib/data";

export async function getStaticPaths() {
  const { products } = await loadProducts();
  // Una guía dinámica con menos productos publicados hoy que su mínimo no se genera: /guias/<slug>/ da 404.
  const publicables = guiasPublicables(loadGuias(), products.filter((p) => isComparable(p)));
  return publicables.map(({ g, productos, notas }) => ({
    params: { slug: g.slug },
    props: { g, productos, notas, otras: publicables.map((o) => o.g).filter((o) => o.slug !== g.slug) },
  }));
}

const { g, productos, notas, otras } = Astro.props;
const url = `${SITE.url}/guias/${g.slug}/`;
const conNotas = Object.keys(notas).length > 0;
const minimoPct = Math.round(MIN_AMAZON_SAVING * 100);
---

<Base
  title={g.title}
  description={g.description}
  jsonLd={[
    { "@type": "Article", headline: g.h1, description: g.description, inLanguage: "es-AR", mainEntityOfPage: url, author: { "@type": "Person", name: "Alejandro Benzoni" }, publisher: { "@type": "Organization", name: SITE.name, url: SITE.url } },
    { "@type": "FAQPage", mainEntity: g.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Guías", item: `${SITE.url}/guias/` },
        { "@type": "ListItem", position: 2, name: g.h1, item: url },
      ],
    },
  ]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Ubicación"><a href="/guias/">Guías</a></nav>
  </div>
  <div class="wrap page-head">
    <h1 class="letra" style="font-size: clamp(34px, 4.2vw, 56px)">{g.h1}</h1>
    <p class="lead" set:html={linkify(g.intro)} />
    <ShareButtons title={g.h1} />
  </div>

  {g.filtro && productos.length > 0 && (
    <section style="padding-top: 16px">
      <div class="wrap">
        <div class="transparencia">
          <h2>Cómo hacemos la cuenta</h2>
          <ul>
            <li>El monto de Amazon es una estimación: el precio de hoy en Amazon más el IVA del 21 % y los cargos de importación que Amazon suma en el checkout, pasado a pesos con el dólar MEP del día y redondeado a $ 10.000.</li>
            <li>Hasta USD 400 por envío no se pagan derechos de importación ni tasa de estadística: es la franquicia del régimen courier (Decreto 1065/2024), con un máximo de 5 envíos por año por persona.</li>
            <li>Si traerlo no ahorra al menos un {minimoPct} %, recomendamos Mercado Libre: llega en días, tiene garantía local y cuotas, y no gastás uno de tus 5 envíos del año.</li>
            <li>La lista se arma de nuevo todos los días con los precios de ese día. Un producto sin precio del día en las dos tiendas no aparece.</li>
          </ul>
          <p>El detalle de cada producto está en «Ver la cuenta completa». Cómo armamos cada número y cuándo recomendamos Mercado Libre: <a href="/como-calculamos/">Cómo calculamos</a>. También podés probar con tus números en la <a href="/calculadora/">calculadora</a>.</p>
        </div>
        <div class="grid-products" style="margin-top: 24px">{productos.map((p) => <ProductCard product={p} ubicacion="guia" nota={conNotas ? (notas[p.slug] ?? {}) : undefined} />)}</div>
      </div>
    </section>
  )}

  <section style="padding-top: 16px">
    <div class="wrap"><div class="prose">
      {g.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p set:html={linkify(p)} />)}
          {s.bullets && <ul>{s.bullets.map((b) => <li set:html={linkify(b)} />)}</ul>}
        </>
      ))}
    </div></div>
  </section>

  {!g.filtro && productos.length > 0 && (
    <section style="padding-top: 0">
      <div class="wrap">
        <div class="head"><h2 class="letra">Productos de esta guía</h2></div>
        <div class="grid-products">{productos.map((p) => <ProductCard product={p} ubicacion="guia" nota={conNotas ? (notas[p.slug] ?? {}) : undefined} />)}</div>
      </div>
    </section>
  )}

  <section class="wrap" style="padding-top: 8px">
    <a class="telegram-cta" href="https://t.me/franquicia400" target="_blank" rel="noopener noreferrer" data-umami-event="telegram" data-umami-event-origen="guia" data-umami-event-guia={g.slug}>
      <span><b>Seguí los precios sin volver a entrar</b>Todos los días a las 12 y a las 20 publicamos en Telegram la mejor oferta del momento, comparada con los precios de ese día.</span>
      <span class="btn">Unirme al canal</span>
    </a>
  </section>

  <section style="padding-top: 24px">
    <div class="wrap"><div class="prose">
      <h2>Preguntas frecuentes</h2>
      {g.faq.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p set:html={linkify(f.a)} />
        </details>
      ))}
      <p style="margin-top: 32px"><a class="btn" href="/calculadora/">Hacer la cuenta <Icon name="arrow-right" size={16} /></a></p>
    </div></div>
  </section>

  {otras.length > 0 && (
    <section style="padding-top: 0">
      <div class="wrap"><div class="prose">
        <h2>Otras guías</h2>
        <ul>{otras.map((o) => <li><a href={`/guias/${o.slug}/`}>{o.h1}</a></li>)}</ul>
      </div></div>
    </section>
  )}
</Base>
