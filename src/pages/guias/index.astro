---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { guiasPublicables, loadGuias } from "../../lib/guias";
import { isComparable, loadProducts } from "../../lib/data";

// Mismo criterio que /guias/[slug]/: una guía dinámica sin el mínimo de productos de hoy no se lista.
const { products } = await loadProducts();
const guias = guiasPublicables(loadGuias(), products.filter((p) => isComparable(p))).map((r) => r.g);
---

<Base title="Guías para comprar en Amazon desde Argentina" description="Cómo funciona la franquicia de USD 400, cómo comprar en Amazon desde Argentina y qué conviene traer: relojes, herramientas, redes y almacenamiento comparados con Mercado Libre.">
  <div class="wrap page-head">
    <h1 class="letra">Guías</h1>
    <p class="lead">Todo lo que conviene saber antes de traer algo de Amazon a Argentina.</p>
  </div>
  <section style="padding-top: 16px">
    <div class="wrap">
      <div class="pizarra">
        {guias.map((g) => (
          <a href={`/guias/${g.slug}/`}>
            <span class="label">{g.h1}<span class="where">{g.description}</span></span>
            <Icon name="arrow-right" size={18} class="go" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
