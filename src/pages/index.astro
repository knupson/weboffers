---
import Base from "../layouts/Base.astro";
import Catalog from "../components/Catalog.astro";
import ProductCard from "../components/ProductCard.astro";
import QuickCalc from "../components/QuickCalc.tsx";
import Icon from "../components/Icon.astro";
import { CATEGORY_ART, SEARCHES, SITE, SOCIAL } from "../config";
import { isComparable, loadProducts } from "../lib/data";

const { products, offers } = await loadProducts();
const shown = products.filter((p) => isComparable(p));
// Lo más vendido de Mercado Libre va en su sección; el resto, en el catálogo de abajo.
const hot = shown.filter((p) => p.hot);
const rest = shown.filter((p) => !p.hot);
const stamp = offers.rates ? `de las ${new Date(offers.rates.fetchedAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/Buenos_Aires" })}` : "de hoy";

// Categorías con productos van al catálogo; las demás, directo a una búsqueda en Amazon.
const withProducts = [...new Set(shown.map((p) => p.category))];
const cats = [
  ...withProducts.map((c) => ({ name: c, href: `/productos/?categoria=${encodeURIComponent(c)}`, sub: ((n) => `${n} ${n === 1 ? "elegido" : "elegidos"}`)(shown.filter((p) => p.category === c).length), external: false })),

];
---

<Base
  jsonLd={[
    { "@type": "WebSite", name: SITE.name, url: SITE.url, inLanguage: "es-AR", description: SITE.description },
    { "@type": "Organization", name: SITE.name, url: SITE.url, logo: `${SITE.url}/icon-512.png`, sameAs: SOCIAL.map((r) => r.url) },
    {
      "@type": "ItemList",
      name: "Dónde conviene comprarlo: Amazon o Mercado Libre",
      itemListElement: shown.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/productos/${p.slug}/`, name: p.name })),
    },
  ]}
>
  <div class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="letra">¿Amazon o<br />Mercado Libre?</h1>
        <p class="lead">Comparamos lo que te sale traerlo puesto en tu casa con lo que sale acá, y te decimos dónde te conviene comprarlo.</p>
        <form class="search" action="/buscar/" method="get" role="search">
          <Icon name="magnifying-glass" size={18} />
          <input name="q" type="search" placeholder="SSD, Ryzen, auriculares, Garmin..." aria-label="Qué producto buscás" required />
          <button class="btn" type="submit" data-umami-event="busqueda">Comparar</button>
        </form>
      </div>
      <div class="placa-hero">
        <img src="/art/placa-hero.webp" alt="" width="1600" height="1185" fetchpriority="high" />
        <ol class="pasos">
          <li><b>Amazon</b><span>Total con envío, IVA y cargos, puesto en tu casa</span></li>
          <li><b>Mercado Libre</b><span>El precio nuevo más barato del mismo modelo</span></li>
          <li><b>Veredicto</b><span>Si traerlo no ahorra al menos 10%, conviene comprarlo acá</span></li>
        </ol>
      </div>
    </div>
  </div>

  <div class="wrap">
    <nav class="cats" aria-label="Categorías">
      {cats.map((c) => (
        <a class="cat" href={c.href} {...(c.external ? { target: "_blank", rel: "noopener noreferrer sponsored", "data-umami-event": "amazon", "data-umami-event-tienda": "ES", "data-umami-event-origen": "categoria" } : {})}>
          <img src={CATEGORY_ART[c.name] ?? shown.find((p) => p.category === c.name)?.image} alt="" loading="lazy" width="900" height="658" />
          <span>{c.name}<small>{c.sub}</small></span>
        </a>
      ))}
    </nav>
  </div>

  {hot.length > 0 && (
    <section id="mas-vendidos" style="padding-top: 48px">
      <div class="wrap">
        <div class="head">
          <h2 class="letra">Lo más vendido esta semana</h2>
          <p>Lo que más se vende en tecnología en Mercado Libre, comparado con traerlo de Amazon.</p>
        </div>
        <div class="grid-products">
          {hot.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <section id="productos" style="padding-top: 48px">
    <div class="wrap">
      <div class="head">
        <h2 class="letra">Dónde conviene cada uno</h2>
        <p>Precio en pesos de Mercado Libre y el veredicto contra el total de Amazon con envío e impuestos.</p>
      </div>
      <Catalog products={rest} />
    </div>
  </section>

  <section style="padding-top: 0">
    <div class="wrap">
      <div class="head">
        <h2 class="letra">¿Buscás otra cosa?</h2>
        <p>Elegí un tema y te mostramos qué tenemos comparado y dónde seguir buscando.</p>
      </div>
      <div class="pizarra">
        {SEARCHES.map((s) => (
          <a href={`/buscar/?q=${encodeURIComponent(s.term)}`} data-umami-event="busqueda-armada" data-umami-event-producto={s.term}>
            <img src={s.art ?? CATEGORY_ART[s.category]} alt="" loading="lazy" width="900" height="658" />
            <span class="label">{s.label}<span class="where">Amazon y Mercado Libre</span></span>
            <Icon name="arrow-right" size={18} class="go" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top: 0">
    <div class="wrap calc-home">
      <div>
        <h2 class="letra">¿Ya viste un precio en Amazon?</h2>
        <p class="lead">Mové la cinta y mirá cuánto te sale puesto en tu casa. Desde USD 100 el envío es gratis; Amazon suma IVA y cargos (≈25%), al dólar MEP <span data-rate-when>{stamp}</span>.</p>
        <a class="link" href="/calculadora/">Hacer la cuenta exacta <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="placa-hero">
        <img src="/art/placa-hero.webp" alt="" width="1600" height="1185" loading="lazy" />
        <QuickCalc client:visible mep={offers.rates?.mep ?? null} />
      </div>
    </div>
  </section>

  <section style="padding-top: 0">
    <div class="wrap">
      <div class="cuenta">
        <h2 class="letra" style="text-align:center; margin-bottom: 24px">Cómo sacamos la cuenta</h2>
        <p class="formula">Producto <span class="op">+</span> envío <span class="op">+</span> IVA y cargos <span class="op">=</span> <span class="res">puesto en tu casa</span></p>
        <p class="nota">Desde USD 100 el envío de Amazon a Argentina es gratis en productos elegibles. El IVA es 21% y Amazon suma sus cargos de importación. Si el producto pasa los USD 400, el excedente paga derechos y tasa de estadística. Ese total lo comparamos con Mercado Libre.</p>
        <ul class="reglamento">
          <li><b>USD 400</b><span>por envío sin derechos de importación</span></li>
          <li><b>5 envíos</b><span>por año y por persona</span></li>
          <li><b>USD 3.000</b><span>tope por envío por courier</span></li>
          <li><b>50 kg</b><span>de peso máximo por envío</span></li>
        </ul>
        <p class="links">
          <a class="link" href="/calculadora/">Hacer la cuenta con tu producto <Icon name="arrow-right" size={16} /></a>
          <a class="link" href="/guia/">Leer la guía <Icon name="arrow-right" size={16} /></a>
        </p>
      </div>
    </div>
  </section>
</Base>
