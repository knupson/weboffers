---
import Base from "../layouts/Base.astro";
import Catalog from "../components/Catalog.astro";
import Icon from "../components/Icon.astro";
import { amazonDealsUrl, amazonSearchUrl, SEARCHES, STORE_LABEL } from "../config";
import { loadProducts } from "../lib/data";

const { products, offers } = await loadProducts();
const shown = products.filter((p) => p.verified);
const ars = (n: number) => `$${Math.round(n).toLocaleString("es-AR")}`;
const mep = offers.rates ? ars(offers.rates.mep) : "...";
const tarjeta = offers.rates ? ars(offers.rates.tarjeta) : "...";
---

<Base>
  <div class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Hardware de Amazon, con la cuenta hecha para Argentina.</h1>
        <p class="lead">Elegí el producto, mirá cuánto te sale puesto en tu casa y comprá directo en Amazon.</p>
        <form class="search" action="/buscar/" method="get" target="_blank" role="search">
          <Icon name="magnifying-glass" size={18} />
          <input name="q" type="search" placeholder="Buscá en Amazon: monitor, SSD, mouse..." aria-label="Qué querés buscar en Amazon" required />
          <select name="tienda" aria-label="Tienda">
            <option value="US">Amazon.com</option>
            <option value="ES">Amazon.es</option>
          </select>
          <button class="btn" type="submit">Buscar</button>
        </form>
      </div>
      <aside class="today" aria-label="Datos del día">
        <div class="pair">
          <div><span class="k">Dólar MEP</span><span class="v num" data-rate="mep">{mep}</span></div>
          <div><span class="k">Dólar tarjeta</span><span class="v num" data-rate="tarjeta">{tarjeta}</span></div>
        </div>
        <div class="rule">
          <Icon name="check-circle" size={20} />
          <p>Hasta <b>USD 400</b> por envío no pagás derechos de importación. Sólo IVA y el envío.</p>
        </div>
      </aside>
    </div>
  </div>

  <section id="productos" style="padding-top: 40px">
    <div class="wrap">
      <div class="head">
        <h2>Productos que entran en la franquicia</h2>
      </div>
      <Catalog products={shown} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>¿Buscás otra cosa?</h2>
        <p>Búsquedas armadas en Amazon, ya filtradas para lo que conviene traer.</p>
      </div>
      <div class="searches">
        {SEARCHES.map((s) => (
          <a href={amazonSearchUrl(s.query, s.store)} target="_blank" rel="noopener noreferrer sponsored">
            <span class="ico-box"><Icon name={s.icon} size={20} /></span>
            <span class="label">{s.label}<span class="where" style="display:block">{STORE_LABEL[s.store]}</span></span>
            <Icon name="arrow-up-right" size={18} class="go" />
          </a>
        ))}
      </div>
      <div class="deals">
        <a class="btn ghost" href={amazonDealsUrl("US")} target="_blank" rel="noopener noreferrer sponsored">Ofertas del día en Amazon.com</a>
        <a class="btn ghost" href={amazonDealsUrl("ES")} target="_blank" rel="noopener noreferrer sponsored">Ofertas del día en Amazon.es</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>Cómo sacamos el costo final</h2>
        <p>Si el producto pasa los USD 400, sólo el excedente suma derechos y tasa de estadística.</p>
      </div>
      <div class="equation">
        <div class="term"><b>Producto</b><span>El precio en Amazon</span></div>
        <div class="op" aria-hidden="true">+</div>
        <div class="term"><b>Envío</b><span>Lo ves al pagar</span></div>
        <div class="op" aria-hidden="true">+</div>
        <div class="term"><b>IVA</b><span>21% sobre todo lo anterior</span></div>
        <div class="op" aria-hidden="true">=</div>
        <div class="term total"><b>Puesto en tu casa</b><span>En pesos al MEP y al dólar tarjeta</span></div>
      </div>
      <div class="facts">
        <div><span class="num">USD 400</span><span>por envío sin derechos</span></div>
        <div><span class="num">5</span><span>envíos por año y por persona</span></div>
        <div><span class="num">USD 3.000</span><span>tope por envío por courier</span></div>
        <div><span class="num">50 kg</span><span>de peso máximo por envío</span></div>
      </div>
      <p style="margin-top: 28px; display: flex; gap: 20px; flex-wrap: wrap">
        <a class="link" href="/calculadora/">Hacer la cuenta con tu producto <Icon name="arrow-right" size={16} /></a>
        <a class="link" href="/guia/">Leer la guía <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>
</Base>
