---
import Base from "../layouts/Base.astro";
import Calculator from "../components/Calculator.tsx";
import ProductCard from "../components/ProductCard.astro";
import { loadProducts } from "../lib/data";

const { products, offers } = await loadProducts();
const featured = products.filter((p) => p.verified).slice(0, 6);
const ars = (n: number) => `$${Math.round(n).toLocaleString("es-AR")}`;
const mep = offers.rates ? ars(offers.rates.mep) : "...";
const tarjeta = offers.rates ? ars(offers.rates.tarjeta) : "...";

const signs = [
  ["#calculadora", "Calculadora", "cuánto sale puesto en tu casa"],
  ["/productos/", "Productos", "hardware con ASIN revisado"],
  ["/guia/", "Cómo funciona", "la franquicia, paso a paso"],
  ["/legal/afiliados/", "Afiliación", "cómo se financia el sitio"],
];
---

<Base>
  <div class="wrap hero" id="top">
    <div class="grid">
      <div class="intro">
        <span class="sector">Sector A · Courier a Argentina</span>
        <h1>Franquicia<br />400</h1>
        <p class="lead">
          Cargás el precio y el envío de Amazon. La calculadora te da el total con IVA y el dólar del día, y te dice si pasás los USD 400.
        </p>
      </div>
      <nav class="signs" aria-label="Accesos">
        {signs.map(([href, label, sub]) => (
          <a class="sign" href={href}>
            <span>{label}<small>{sub}</small></span>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
        ))}
      </nav>
    </div>
    <div class="plates">
      <div><span class="k">Franquicia por envío (USD FOB)</span><span class="v" data-count>400</span></div>
      <div><span class="k">Envíos por año y persona</span><span class="v" data-count>5</span></div>
      <div><span class="k">Dólar MEP</span><span class="v" data-rate="mep">{mep}</span></div>
      <div><span class="k">Dólar tarjeta</span><span class="v" data-rate="tarjeta">{tarjeta}</span></div>
    </div>
  </div>

  <section id="calculadora">
    <div class="wrap">
      <div data-reveal style="margin-bottom: var(--s4)">
        <span class="sector">Sector B</span>
        <h2>La cuenta</h2>
      </div>
      <Calculator client:load buildRates={offers.rates} />
    </div>
  </section>

  <section class="alt">
    <div class="wrap grid">
      <div class="side" data-reveal>
        <span class="sector">Sector C</span>
        <h2>Qué se paga</h2>
        <p class="intro">La norma, resumida. El detalle está en la guía.</p>
      </div>
      <div class="main steps">
        <div data-reveal>
          <span class="n">01</span>
          <h3>Hasta USD 400</h3>
          <p>Sin derechos de importación ni tasa de estadística. Pagás el IVA y el envío.</p>
        </div>
        <div data-reveal>
          <span class="n">02</span>
          <h3>Si te pasás</h3>
          <p>Sólo el excedente paga derechos y tasa de estadística. Los primeros USD 400 siguen exentos.</p>
        </div>
        <div data-reveal>
          <span class="n">03</span>
          <h3>Cinco envíos</h3>
          <p>El cupo es por persona y por año. Conviene juntar compras en un solo envío cuando se puede.</p>
        </div>
        <div data-reveal>
          <span class="n">04</span>
          <h3>IVA</h3>
          <p>Calculamos con 21%. La alícuota correcta depende de cada producto y todavía no la confirmamos, por eso la podés cambiar.</p>
        </div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section>
      <div class="wrap grid">
        <div class="side" data-reveal>
          <span class="sector">Sector D</span>
          <h2>Para mirar</h2>
          <p class="intro">Productos que entran en la franquicia. El precio miralo en Amazon y cargalo arriba.</p>
        </div>
        <div class="main projects">
          {featured.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>
