---
import Base from "../../layouts/Base.astro";
import { LEGAL, type LegalId } from "../../content/legal";

export function getStaticPaths() {
  return Object.keys(LEGAL).map((doc) => ({ params: { doc } }));
}

const { doc } = Astro.params;
const entry = LEGAL[doc as LegalId];
---

<Base title={entry.title} description={entry.summary}>
  <div class="wrap page-head">
    <p class="fine">Actualizado el {entry.updated}</p>
    <h1>{entry.title}</h1>
    <p class="lead">{entry.summary}</p>
  </div>
  <section style="padding-top: 8px">
    <div class="wrap">
      <article class="prose">
        {entry.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            {s.body.map((p) => <p>{p}</p>)}
            {s.bullets && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}
          </>
        ))}
      </article>
    </div>
  </section>
</Base>
