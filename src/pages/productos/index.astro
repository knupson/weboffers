---
import Base from "../../layouts/Base.astro";
import Catalog from "../../components/Catalog.astro";
import { loadProducts } from "../../lib/data";

const { products } = await loadProducts();
const shown = products.filter((p) => p.verified);
---

<Base title="Productos" description="Hardware de Amazon que entra en la franquicia de USD 400, con el costo final para Argentina.">
  <div class="wrap page-head">
    <h1 class="letra">Productos</h1>
    <p class="lead">Hardware que entra en la franquicia de USD 400. Entrá a cada uno para ver cuánto te sale puesto en tu casa.</p>
  </div>
  <section style="padding-top: 24px">
    <div class="wrap">
      {shown.length === 0 ? (
        <p class="lead">Todavía no hay productos revisados. Mientras tanto la <a class="link" href="/calculadora/">calculadora</a> funciona con cualquier precio.</p>
      ) : (
        <Catalog products={shown} />
      )}
    </div>
  </section>
</Base>
