---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { loadProducts } from "../../lib/data";

const { products } = await loadProducts();
const shown = products.filter((p) => p.verified);
---

<Base title="Productos" description="Hardware que entra en la franquicia de USD 400, con link a Amazon y calculadora de costo final.">
  <div class="wrap hero">
    <span class="sector">Sector D · Productos</span>
    <h1>Productos</h1>
    <p class="lead">Una lista corta. Cada ficha lleva a Amazon y a la calculadora.</p>
  </div>
  <section>
    <div class="wrap">
      {shown.length === 0 ? (
        <p class="lead">Todavía no hay productos revisados. Mientras tanto la <a href="/#calculadora">calculadora</a> funciona con cualquier precio.</p>
      ) : (
        <div class="projects three">
          {shown.map((p) => <ProductCard product={p} />)}
        </div>
      )}
    </div>
  </section>
</Base>
