---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { loadProducts } from "../../lib/data";

const { products } = await loadProducts();
const shown = products.filter((p) => p.verified);
---

<Base title="Productos" description="Hardware que entra en la franquicia de USD 400, con link a Amazon y calculadora de costo final.">
  <section class="wrap section">
    <h1>Productos</h1>
    <p class="lede" style="margin-top: 16px">
      Una lista corta, revisada a mano. Cada ficha te lleva a Amazon y a la calculadora con el precio cargado.
    </p>

    {shown.length === 0 ? (
      <p class="empty card">
        Todavía no hay productos verificados. Mientras tanto podés usar la calculadora con cualquier precio.
        <a href="/#calculadora">Ir a la calculadora</a>
      </p>
    ) : (
      <div class="grid">
        {shown.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    )}
  </section>
</Base>

<style>
  .grid {
    margin-top: 48px;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .empty {
    margin-top: 48px;
    padding: 28px;
    color: var(--muted);
    display: grid;
    gap: 8px;
    max-width: 560px;
  }
</style>
