---
import Base from "../../layouts/Base.astro";
import Calculator from "../../components/Calculator.tsx";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import { amazonUrl, artFor, SITE, STORE_LABEL } from "../../config";
import { brandLogo } from "../../lib/brands";
import { formatArs } from "../../lib/format";
import { loadProducts } from "../../lib/data";

export async function getStaticPaths() {
  const { products, offers } = await loadProducts();
  const shown = products.filter((p) => p.verified);
  return shown.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      rates: offers.rates,
      related: shown.filter((o) => o.slug !== product.slug && o.category === product.category).slice(0, 3),
    },
  }));
}

const { product: p, rates, related } = Astro.props;
const buy = amazonUrl(p.asin, p.store);
const photo = p.price?.imageUrl ?? p.image ?? null;
const logo = brandLogo(p.brand);

const specs: Array<[string, string]> = [
  ["Marca", p.brand],
  ["Tienda", STORE_LABEL[p.store]],
  ["Tensión", p.voltage ?? "Mirala en la ficha de Amazon"],
  ["Peso", p.weightKg ? `${p.weightKg.toString().replace(".", ",")} kg` : "Sin dato"],
];
---

<Base
  title={`${p.name}: cuánto sale traerlo a Argentina`}
  description={`${p.summary} Calculá el costo final en pesos con la franquicia de USD 400, IVA y dólar del día.`}
  jsonLd={[
    {
      "@type": "Product",
      name: p.name,
      brand: { "@type": "Brand", name: p.brand },
      description: p.summary,
      category: p.category,
      sku: p.asin,
      ...(p.image ? { image: `${SITE.url}${p.image}` } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Productos", item: `${SITE.url}/productos/` },
        { "@type": "ListItem", position: 2, name: p.name, item: `${SITE.url}/productos/${p.slug}/` },
      ],
    },
  ]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Ubicación">
      <a href="/productos/">Productos</a><span aria-hidden="true">/</span><span>{p.category}</span>
    </nav>
    <div class="pdp">
      <div>
        <div class="media">
          {photo ? <img class="photo" src={photo} alt={p.name} /> : <img src={artFor(p)} alt="" width="900" height="658" />}
          <span class="badge">
            {logo ? <svg viewBox={logo.viewBox} style={logo.ratio === 1 ? "height:24px;aspect-ratio:1" : `aspect-ratio:${logo.ratio}`} role="img" aria-label={p.brand}><path d={logo.path} /></svg> : p.brand}
          </span>
        </div>
        {photo ? (
          !p.price?.imageUrl && p.imageSource && <p class="ilus">Foto: <a href={p.imageSource} rel="noopener nofollow" target="_blank">{p.brand}</a></p>
        ) : (
          <p class="ilus">Ilustración de la categoría. La foto real del producto está en Amazon.</p>
        )}
        <h1>{p.name}</h1>
        <p class="lead">{p.summary}</p>
        <dl class="specs">
          {specs.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      </div>

      <div class="buybox">
        <div class="buy">
          {p.ml && (
            <p class="precio">
              <span class="lab">En Argentina</span>
              <span class="monto num">{formatArs(p.ml.price)}</span>
              <small>Mercado Libre, consultado el {p.ml.checked.split("-").reverse().join("/")}</small>
            </p>
          )}
          {p.verdict === "amazon" && p.ml && (
            <>
              <a class="gana amazon" href={buy} target="_blank" rel="noopener noreferrer sponsored" data-umami-event="amazon" data-umami-event-tienda={p.store} data-umami-event-producto={p.slug} data-umami-event-origen="ficha-veredicto">
                <span class="v">Conviene traerlo: Amazon lo deja más barato puesto en tu casa</span>
                <span class="cta">Comprar en Amazon <Icon name="arrow-up-right" size={18} /></span>
              </a>
              <a class="alt" href={p.ml.url} target="_blank" rel="noopener noreferrer sponsored" data-umami-event="mercadolibre" data-umami-event-producto={p.slug} data-umami-event-origen="ficha-alternativa">o comprarlo en Mercado Libre</a>
            </>
          )}
          {(p.verdict ?? "ml") === "ml" && p.ml && (
            <>
              <a class="gana ml" href={p.ml.url} target="_blank" rel="noopener noreferrer sponsored" data-umami-event="mercadolibre" data-umami-event-producto={p.slug} data-umami-event-origen="ficha-veredicto">
                <span class="v">Conviene comprarlo acá: llega en días, sin aduana y con garantía local</span>
                <span class="cta">Comprar en Mercado Libre <Icon name="arrow-up-right" size={18} /></span>
              </a>
              <a class="alt" href={buy} target="_blank" rel="noopener noreferrer sponsored" data-umami-event="amazon" data-umami-event-tienda={p.store} data-umami-event-producto={p.slug} data-umami-event-origen="ficha-alternativa">o traerlo de Amazon</a>
            </>
          )}
          {!p.ml && (
            <a class="btn lg" href={buy} target="_blank" rel="noopener noreferrer sponsored" data-umami-event="amazon" data-umami-event-tienda={p.store} data-umami-event-producto={p.slug} data-umami-event-origen="ficha">Ver en {STORE_LABEL[p.store]} <Icon name="arrow-up-right" size={18} /></a>
          )}
          <p class="fine">Comparamos el total que cobra Amazon con envío e impuestos contra el precio nuevo más barato del mismo modelo en Mercado Libre. Para tu cuenta exacta, pegá abajo el precio de Amazon de hoy. {SITE.disclosure}</p>
        </div>
        <div id="calculadora" style="scroll-margin-top: 96px">
        <Calculator client:visible buildRates={rates} initialFob={p.price?.priceUsd ?? null} currency={p.store === "ES" ? "EUR" : "USD"} title="¿Cuánto te sale traerlo?" buy={{ url: buy, store: p.store, slug: p.slug }} />
        </div>
      </div>
    </div>
  </div>

  {related.length > 0 && (
    <section style="padding-top: 0">
      <div class="wrap">
        <div class="head"><h2>Más {p.category.toLowerCase()}</h2></div>
        <div class="grid-products">
          {related.map((r) => <ProductCard product={r} />)}
        </div>
      </div>
    </section>
  )}
</Base>
