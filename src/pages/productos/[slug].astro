---
import Base from "../../layouts/Base.astro";
import { amazonUrl, SITE } from "../../config";
import { formatUsd, formatStamp } from "../../lib/format";
import { loadProducts } from "../../lib/data";

export async function getStaticPaths() {
  const { products } = await loadProducts();
  return products
    .filter((p) => p.verified)
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product: p } = Astro.props;
const calcHref = p.price ? `/?fob=${p.price.priceUsd}#calculadora` : "/#calculadora";

const rows: Array<[string, string]> = [
  ["Marca", p.brand],
  ["Categoría", p.category],
  ["Tienda", p.store === "ES" ? "Amazon España" : "Amazon Estados Unidos"],
  ["Tensión", p.voltage ?? "Mirala en la ficha de Amazon"],
  ["Peso", p.weightKg ? `${p.weightKg.toString().replace(".", ",")} kg` : "Sin dato"],
  ["Posición arancelaria", p.ncm ?? "Sin confirmar"],
];
---

<Base title={p.name} description={p.summary}>
  <div class="wrap hero">
    <a class="crumb" href="/productos/">Productos</a>
    <h1 style="font-size: clamp(34px, 5.4vw, 64px)">{p.name}</h1>
    <p class="lead">{p.summary}</p>
  </div>
  <section>
    <div class="wrap grid">
      <div class="side">
        <div class="spec">
          {rows.map(([k, v]) => (
            <div class="row"><span class="lab">{k}</span><span class="v">{v}</span></div>
          ))}
        </div>
      </div>
      <div class="main">
        {p.price ? (
          <>
            <span class="price-line">{formatUsd(p.price.priceUsd as number)}</span>
            <p class="stamp">Consultado el {formatStamp(p.price.priceFetchedAt as string)}. {SITE.priceNotice}</p>
          </>
        ) : (
          <p class="lead" style="margin-top: 0">No tenemos precio para mostrar. Miralo en Amazon y cargalo en la calculadora para ver cuánto sale puesto en tu casa.</p>
        )}
        <div class="actions" style="margin-top: var(--s3)">
          <a class="btn" href={amazonUrl(p.asin, p.store)} target="_blank" rel="noopener noreferrer sponsored">Ver en Amazon</a>
          <a class="btn ghost" href={calcHref}>Calcular costo final</a>
        </div>
        <p class="stamp" style="margin-top: var(--s3)">{SITE.disclosure}</p>
      </div>
    </div>
  </section>
</Base>
