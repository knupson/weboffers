---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { SITE } from "../config";
import { loadOffers } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: hardware de Amazon con el costo final para Argentina`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const path = Astro.url.pathname;

const { rates } = await loadOffers();
const mep = rates ? `$${Math.round(rates.mep).toLocaleString("es-AR")}` : "...";

const nav = [
  ["/productos/", "Productos"],
  ["/calculadora/", "Calculadora"],
  ["/guia/", "Cómo funciona"],
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="top">
      <div class="wrap">
        <a class="logo" href="/" aria-label={`${SITE.name}, inicio`}>
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="9" fill="var(--accent)" />
            <path d="M16 7.5v11.5M10.5 14l5.5 5.5 5.5-5.5M9 24.5h14" stroke="var(--on-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Secciones">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <span class="rate-pill">MEP <b class="num" data-rate="mep">{mep}</b></span>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div>
          <p>{SITE.disclosure}</p>
          <p>{SITE.priceNotice}</p>
        </div>
        <nav aria-label="Legales">
          <a href="/legal/afiliados/">Afiliación con Amazon</a>
          <a href="/legal/privacidad/">Privacidad</a>
          <a href="/legal/cookies/">Cookies</a>
          <a href="/legal/terminos/">Términos</a>
          <a href={SITE.parent.url} rel="noopener">Un proyecto de KnuNet</a>
        </nav>
      </div>
    </footer>

    <script>
      import { fetchRates } from "../lib/dolar";
      // Actualiza las cotizaciones impresas en la página con el valor del momento.
      fetchRates().then((r) => {
        if (!r) return;
        document.querySelectorAll<HTMLElement>("[data-rate]").forEach((el) => {
          const key = el.dataset.rate as "mep" | "tarjeta";
          el.textContent = `$${Math.round(r[key]).toLocaleString("es-AR")}`;
        });
      });
    </script>
  </body>
</html>
