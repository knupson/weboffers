---
import "@fontsource/ultra";
import "@fontsource-variable/archivo";
import "../styles/global.css";
import { SITE, SOCIAL, UMAMI } from "../config";
import { siInstagram, siTelegram, siYoutube } from "simple-icons";

const socialIcon = { YouTube: siYoutube, Telegram: siTelegram, Instagram: siInstagram };
import { loadOffers, loadPricesDate } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
  /** Datos estructurados (schema.org) de la página. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = SITE.description, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ¿Amazon o Mercado Libre? Dónde te conviene comprarlo`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const path = Astro.url.pathname;

const { rates, items } = await loadOffers();
const pricesDate = loadPricesDate();
const hasPrices = items.some((i) => i.priceUsd != null);
const stamp = rates ? new Date(rates.fetchedAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/Buenos_Aires" }) : "";
const mep = rates ? `$${Math.round(rates.mep).toLocaleString("es-AR")}` : "...";

const nav = [
  ["/productos/", "Productos"],
  ["/calculadora/", "Calculadora"],
  ["/guias/", "Guías"],
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141210" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...d })} />)}
    <script is:inline defer src={UMAMI.src} data-website-id={UMAMI.id} data-domains="ofertas.knunet.com" data-do-not-track="true" data-exclude-hash="true"></script>
    <slot name="head" />
  </head>
  <body data-prices-date={pricesDate}>
    <a class="skip" href="#main">Saltar al contenido</a>
    <div class="aviso-precios" data-stale-banner hidden role="status">
      <div class="wrap">Estamos actualizando los precios de hoy</div>
    </div>
    <header class="top">
      <div class="wrap">
        <a class="logo letra" href="/" aria-label={`${SITE.name}, inicio`}>{SITE.name}</a>
        <nav aria-label="Secciones">
          {nav.map(([href, label]) => (
            <a href={href} class={href === "/guias/" ? "hide-sm" : undefined} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <span class="rate-pill">MEP <b class="num" data-rate="mep">{mep}</b> <small data-rate-time>{stamp}</small></span>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="filete-h" aria-hidden="true"></div>
        <div>
        <div>
          <p>{SITE.disclosure}</p>
          {hasPrices && <p>{SITE.priceNotice}</p>}
          <ul class="redes" aria-label="Redes de Franquicia 400">
            {SOCIAL.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener me" data-umami-event="red" data-umami-event-red={r.name}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={socialIcon[r.name].path} /></svg>
                  <span>{r.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <nav aria-label="Legales">
          <a href="/guia/">Cómo funciona la franquicia</a>
          <a href="/guias/">Guías</a>
          <a href="/legal/afiliados/">Afiliación con Amazon y Mercado Libre</a>
          <a href="/legal/privacidad/">Privacidad</a>
          <a href="/legal/cookies/">Cookies</a>
          <a href="/legal/terminos/">Términos</a>
          <a href="mailto:ofertas@knunet.com" data-umami-event="contacto">ofertas@knunet.com</a>
          <a href={SITE.parent.url} rel="noopener">Un proyecto de KnuNet</a>
        </nav>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const ART_OFFSET_MS = -3 * 3600 * 1000;
        const DAY_MS = 86400 * 1000;

        const artToday = () => {
          const parts = Object.fromEntries(
            new Intl.DateTimeFormat("en-CA", {
              timeZone: "America/Argentina/Buenos_Aires",
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            })
              .formatToParts(new Date())
              .map((p) => [p.type, p.value]),
          );
          return `${parts.year}-${parts.month}-${parts.day}`;
        };

        // Reevalúa la vigencia de precios en cada cambio de día ART, al volver a la pestaña y en pageshow.
        const evaluatePriceGuard = () => {
          const today = artToday();
          const bodyDate = document.body?.dataset?.pricesDate || "";
          const banner = document.querySelector("[data-stale-banner]");
          if (banner) banner.hidden = bodyDate === today;

          document.querySelectorAll("[data-checked]").forEach((block) => {
            const isFresh = block.getAttribute("data-checked") === today;
            if (isFresh) {
              block.setAttribute("data-fresh", "true");
            } else {
              block.removeAttribute("data-fresh");
            }
            block
              .querySelectorAll("[data-price-amount], [data-price-label], [data-price-sub], [data-verdict-text]")
              .forEach((el) => {
                el.hidden = !isFresh;
              });
            if (isFresh) {
              block.querySelectorAll("[data-price-label]").forEach((el) => {
                el.textContent = "precio de hoy";
              });
            }
            block.querySelectorAll("[data-price-stale]").forEach((el) => {
              el.hidden = isFresh;
            });
            block.querySelectorAll(".fila-compra").forEach((row) => {
              const winner = row.getAttribute("data-winner");
              if (isFresh && (winner === "ml" || winner === "amazon")) {
                row.classList.add("ganadora", winner);
              } else {
                row.classList.remove("ganadora", "ml", "amazon");
              }
            });
            block.querySelectorAll("[data-buy-link]").forEach((link) => {
              const winner = link.getAttribute("data-winner");
              link.className = isFresh && (winner === "ml" || winner === "amazon") ? `gana ${winner}` : "btn ghost sm";
              const verbs = link.querySelectorAll("[data-buy-verb]");
              if (verbs.length > 0) {
                verbs.forEach((v) => {
                  v.textContent = isFresh ? "Comprar" : "Ver";
                });
              } else if (!isFresh) {
                link.textContent = link.getAttribute("data-buy-link") === "ml" ? "Ver en Mercado Libre" : "Ver en Amazon";
              }
            });
          });
        };

        let midnightTimer;
        const scheduleMidnightCheck = () => {
          if (midnightTimer) clearTimeout(midnightTimer);
          const artMs = Date.now() + ART_OFFSET_MS;
          const elapsed = ((artMs % DAY_MS) + DAY_MS) % DAY_MS;
          const delay = Math.max(50, DAY_MS - elapsed + 50);
          midnightTimer = setTimeout(() => {
            evaluatePriceGuard();
            scheduleMidnightCheck();
          }, delay);
        };

        const refreshGuard = () => {
          evaluatePriceGuard();
          scheduleMidnightCheck();
        };

        refreshGuard();
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState !== "hidden") refreshGuard();
        });
        window.addEventListener("pageshow", refreshGuard);
      })();
    </script>

    <script>
      import { fetchRates } from "../lib/dolar";
      // Actualiza las cotizaciones impresas en la página con el valor del momento.
      fetchRates().then((r) => {
        if (!r) return;
        document.querySelectorAll<HTMLElement>("[data-rate]").forEach((el) => {
          const key = el.dataset.rate as "mep" | "tarjeta";
          el.textContent = `$${Math.round(r[key]).toLocaleString("es-AR")}`;
        });
        const hora = new Date(r.fetchedAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/Buenos_Aires" });
        document.querySelectorAll<HTMLElement>("[data-rate-time]").forEach((el) => (el.textContent = hora));
        document.querySelectorAll<HTMLElement>("[data-rate-when]").forEach((el) => (el.textContent = `de las ${hora}`));
      });
    </script>
  </body>
</html>
