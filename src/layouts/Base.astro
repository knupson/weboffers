---
import "@fontsource/ultra";
import "@fontsource-variable/archivo";
import "../styles/global.css";
import { SITE, UMAMI } from "../config";
import { loadOffers } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
  /** Datos estructurados (schema.org) de la página. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = SITE.description, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: hardware de Amazon con el costo final para Argentina`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const path = Astro.url.pathname;

const { rates, items } = await loadOffers();
const hasPrices = items.some((i) => i.priceUsd != null);
const stamp = rates ? new Date(rates.fetchedAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/Buenos_Aires" }) : "";
const mep = rates ? `$${Math.round(rates.mep).toLocaleString("es-AR")}` : "...";

const nav = [
  ["/productos/", "Productos"],
  ["/calculadora/", "Calculadora"],
  ["/guia/", "Cómo funciona"],
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141210" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...d })} />)}
    <script is:inline defer src={UMAMI.src} data-website-id={UMAMI.id} data-domains="ofertas.knunet.com" data-do-not-track="true"></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="top">
      <div class="wrap">
        <a class="logo letra" href="/" aria-label={`${SITE.name}, inicio`}>{SITE.name}</a>
        <nav aria-label="Secciones">
          {nav.map(([href, label]) => (
            <a href={href} class={href === "/guia/" ? "hide-sm" : undefined} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <span class="rate-pill">MEP <b class="num" data-rate="mep">{mep}</b> <small data-rate-time>{stamp}</small></span>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="filete-h" aria-hidden="true"></div>
        <div>
        <div>
          <p>{SITE.disclosure}</p>
          {hasPrices && <p>{SITE.priceNotice}</p>}
        </div>
        <nav aria-label="Legales">
          <a href="/legal/afiliados/">Afiliación con Amazon</a>
          <a href="/legal/privacidad/">Privacidad</a>
          <a href="/legal/cookies/">Cookies</a>
          <a href="/legal/terminos/">Términos</a>
          <a href="mailto:ofertas@knunet.com" data-umami-event="contacto">ofertas@knunet.com</a>
          <a href={SITE.parent.url} rel="noopener">Un proyecto de KnuNet</a>
        </nav>
        </div>
      </div>
    </footer>

    <script>
      import { fetchRates } from "../lib/dolar";
      // Actualiza las cotizaciones impresas en la página con el valor del momento.
      fetchRates().then((r) => {
        if (!r) return;
        document.querySelectorAll<HTMLElement>("[data-rate]").forEach((el) => {
          const key = el.dataset.rate as "mep" | "tarjeta";
          el.textContent = `$${Math.round(r[key]).toLocaleString("es-AR")}`;
        });
        const hora = new Date(r.fetchedAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/Buenos_Aires" });
        document.querySelectorAll<HTMLElement>("[data-rate-time]").forEach((el) => (el.textContent = hora));
        document.querySelectorAll<HTMLElement>("[data-rate-when]").forEach((el) => (el.textContent = `de las ${hora}`));
      });
    </script>
  </body>
</html>
