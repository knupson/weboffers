---
import ProductCard from "./ProductCard.astro";
import Icon from "./Icon.astro";
import type { CatalogEntry, OfferItem } from "../lib/data";
import type { Ubicacion } from "../lib/analytics";

interface Props {
  products: Array<CatalogEntry & { price: OfferItem | null; offer?: OfferItem }>;
  ubicacion: Ubicacion;
}

const { products, ubicacion } = Astro.props;
const counts = new Map<string, number>();
for (const p of products) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<div data-catalog>
  <div class="chips" role="group" aria-label="Filtrar por categoría">
    <button class="chip" type="button" data-filter="" aria-pressed="true">Todo<span class="count">{products.length}</span></button>
    {categories.map(([c, n]) => (
      <button class="chip" type="button" data-filter={c} aria-pressed="false">{c}<span class="count">{n}</span></button>
    ))}
  </div>
  <p class="disclose">
    <Icon name="tag" size={16} />
    Son links de afiliado: si comprás, Amazon o Mercado Libre nos pagan una comisión y a vos te sale lo mismo. Las fotos son del fabricante; donde no hay, va una ilustración de la categoría.
  </p>
  <div class="grid-products">
    {products.map((p) => <ProductCard product={p} ubicacion={ubicacion} />)}
  </div>
</div>

<script>
  import { trackFiltrarCategoria } from "../lib/analytics";

  document.querySelectorAll<HTMLElement>("[data-catalog]").forEach((root) => {
    const chips = root.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = root.querySelectorAll<HTMLElement>(".card");
    const apply = (chip: HTMLButtonElement) => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      cards.forEach((card) => (card.hidden = !!f && card.dataset.category !== f));
    };
    // 13/11: sólo el click del usuario es micro-conversión; el filtro que llega por ?categoria= no.
    chips.forEach((chip) => chip.addEventListener("click", () => {
      apply(chip);
      trackFiltrarCategoria(chip.dataset.filter ?? "");
    }));
    const wanted = new URLSearchParams(location.search).get("categoria");
    const match = [...chips].find((c) => c.dataset.filter === wanted);
    if (match) apply(match);
  });
</script>
