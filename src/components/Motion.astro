<script is:inline>
  // Revelado al scrollear (una sola vez) y conteo de los números del HUD.
  // Sin JS o con movimiento reducido, todo queda visible y con su valor final.
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.setAttribute('data-visible', ''));
      return;
    }

    items.forEach((el) => {
      const group = [...el.parentElement.children].filter((c) => c.hasAttribute('data-reveal'));
      el.style.setProperty('--d', `${Math.min(group.indexOf(el), 5) * 60}ms`);
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.setAttribute('data-visible', '');
        io.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -8% 0px' });
    items.forEach((el) => io.observe(el));

    const easeOut = (t) => 1 - Math.pow(1 - t, 4);
    document.querySelectorAll('[data-count]').forEach((el, i) => {
      const full = el.textContent;
      const m = full.match(/^(\d+)(.*)$/);
      if (!m) return;
      const to = Number(m[1]);
      const rest = m[2];
      const start = performance.now() + 700 + i * 90;
      const duration = 1300;
      el.textContent = `0${rest}`;
      const tick = (now) => {
        const t = Math.min(1, Math.max(0, (now - start) / duration));
        el.textContent = t < 1 ? `${Math.round(to * easeOut(t))}${rest}` : full;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  })();
</script>
