---
import Icon from "./Icon.astro";
import { siWhatsapp, siX } from "simple-icons";
import { SITE } from "../config";
import { shareLinks } from "../lib/share";
interface Props { title: string }
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const links = shareLinks(title, url);
---
<div class="share" role="group" aria-label="Compartir esta página">
  {[{ key: "whatsapp", label: "WhatsApp", icon: siWhatsapp }, { key: "x", label: "X", icon: siX }].map(({ key, label, icon }) => (
    <a class="btn ghost sm" href={links[key as keyof typeof links]} target="_blank" rel="noopener noreferrer" aria-label={`Compartir en ${label}`} data-umami-event="compartir" data-umami-event-red={key}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon.path} /></svg>{label}
    </a>
  ))}
  <button class="btn ghost sm" type="button" hidden data-native-share data-title={title} data-url={url} aria-label="Compartir con otras aplicaciones" data-umami-event="compartir" data-umami-event-red="nativo"><Icon name="share-network" size={18} />Compartir</button>
</div>
<script>
  import { enableNativeShare } from "../lib/share";
  enableNativeShare(document, navigator);
</script>
<style>
  .share { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0; }
  [hidden] { display: none !important; }
</style>
