---
import Icon from "./Icon.astro";
import { amazonUrl, CATEGORY_ICON, STORE_LABEL } from "../config";
import { formatUsd, formatStamp } from "../lib/format";
import type { CatalogEntry, OfferItem } from "../lib/data";

interface Props {
  product: CatalogEntry & { price: OfferItem | null; offer?: OfferItem };
}

const { product: p } = Astro.props;
const image = p.price?.imageUrl ?? null;
---

<article class="card" data-category={p.category}>
  <div class="media">
    {image ? <img src={image} alt="" loading="lazy" /> : <Icon name={CATEGORY_ICON[p.category] ?? "package"} size={56} />}
    <span class="store">{STORE_LABEL[p.store]}</span>
  </div>
  <div class="body">
    <span class="brand">{p.brand} · {p.category}</span>
    <h3><a href={`/productos/${p.slug}/`}>{p.name}</a></h3>
    <p class="sum">{p.summary}</p>
  </div>
  <div class="foot">
    {p.price ? (
      <span class="price num">
        {formatUsd(p.price.priceUsd as number)}
        <small>al {formatStamp(p.price.priceFetchedAt as string)}</small>
      </span>
    ) : (
      <a class="btn sm ghost" href={`/productos/${p.slug}/`}>Costo final</a>
    )}
    <a class="btn sm" href={amazonUrl(p.asin, p.store)} target="_blank" rel="noopener noreferrer sponsored">
      Ver en Amazon <Icon name="arrow-up-right" size={16} />
    </a>
  </div>
</article>
