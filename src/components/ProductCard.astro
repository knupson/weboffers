---
import Icon from "./Icon.astro";
import { amazonUrl, artFor } from "../config";
import { brandLogo } from "../lib/brands";
import { formatArs } from "../lib/format";
import { comparePrices, type CatalogEntry, type OfferItem } from "../lib/data";

interface Props {
  product: CatalogEntry & { price: OfferItem | null; offer?: OfferItem };
}

// Dos filas en pesos con el mismo peso visual: Mercado Libre y el estimado de Amazon puesto en casa,
// cada una con su propio botón de compra. Nunca se muestra el precio en USD/EUR de Amazon.
const { product: p } = Astro.props;
const photo = p.price?.imageUrl ?? p.image ?? null;
const logo = brandLogo(p.brand);
const free = p.shipsToAr?.freeShipping === true;
const amazon = p.asin ? amazonUrl(p.asin, p.store) : null;
const mlFecha = p.ml?.checked.split("-").reverse().slice(0, 2).join("/");
const amzFecha = p.amazonChecked?.split("-").reverse().slice(0, 2).join("/");
const checkedDate =
  p.ml?.checked && p.amazonChecked && p.ml.checked === p.amazonChecked
    ? p.ml.checked
    : (p.ml?.checked ?? p.amazonChecked ?? "");
const amzLabel = p.store === "ES" ? "Traerlo de España" : "Traerlo de EE.UU.";
const amzSub = amzFecha
  ? `puesto en tu casa, estimado al ${amzFecha}`
  : "puesto en tu casa, estimado";
const { verdict, saving } = comparePrices(p);
const track = (tienda: string, origen: string) => ({
  "data-umami-event": tienda === "ml" ? "mercadolibre" : "amazon",
  "data-umami-event-tienda": tienda === "ml" ? "ML" : p.store,
  "data-umami-event-producto": p.slug,
  "data-umami-event-origen": origen,
});
const ext = { target: "_blank", rel: "noopener noreferrer sponsored" };
---

<article class="card" data-category={p.category}>
  <div class="media">
    {photo ? (
      <img class="photo" src={photo} alt="" loading="lazy" />
    ) : (
      <img src={artFor(p)} alt="" loading="lazy" width="900" height="658" />
    )}
    <span class="badge" title={p.brand}>
      {logo ? <svg viewBox={logo.viewBox} style={logo.ratio === 1 ? "height:24px;aspect-ratio:1" : `aspect-ratio:${logo.ratio}`} role="img" aria-label={p.brand}><path d={logo.path} /></svg> : p.brand}
    </span>
    {free && <span class="envio"><Icon name="truck" size={14} /> Envío gratis a Argentina</span>}
  </div>
  <div class="body">
    <h3><a href={`/productos/${p.slug}/`}>{p.name}</a></h3>
    <p class="sum">{p.summary}</p>
  </div>
  <div class="foot" data-checked={checkedDate}>
    {p.ml && (
      <div class="fila-compra" data-winner={verdict === "ml" ? "ml" : undefined}>
        <p class="precio">
          <span class="lab">Mercado Libre</span>
          <span class="monto num" data-price-amount hidden>{formatArs(p.ml.price)}</span>
          <span class="precio-actualizando" data-price-stale>Precio en actualización</span>
          <small data-price-label hidden>{mlFecha ? `precio del ${mlFecha}` : ""}</small>
        </p>
        {verdict === "ml" ? (
          <>
            <p class="veredicto" data-verdict-text hidden>Conviene{saving > 0 ? ` · ahorrás ~${formatArs(saving)}` : ""}</p>
            <a class="btn ghost sm" data-buy-link="ml" data-winner="ml" href={p.ml.url} {...ext} {...track("ml", "veredicto")}>
              <span class="cta"><span class="cta-txt"><span data-buy-verb>Ver</span> en Mercado&nbsp;Libre</span><Icon name="arrow-up-right" size={16} /></span>
            </a>
          </>
        ) : (
          <a class="btn ghost sm" data-buy-link="ml" href={p.ml.url} {...ext} {...track("ml", "alternativa")}>
            <span class="cta"><span class="cta-txt"><span data-buy-verb>Ver</span> en Mercado&nbsp;Libre</span><Icon name="arrow-up-right" size={16} /></span>
          </a>
        )}
      </div>
    )}

    {p.amazonArs != null && amazon && (
      <div class="fila-compra" data-winner={verdict === "amazon" ? "amazon" : undefined}>
        <p class="precio">
          <span class="lab">{amzLabel}</span>
          <span class="monto num" data-price-amount hidden>~{formatArs(p.amazonArs)}</span>
          <span class="precio-actualizando" data-price-stale>Precio en actualización</span>
          <small data-price-sub hidden>{amzSub}</small>
        </p>
        {verdict === "sinEnvio" && (
          <p class="veredicto nota" data-verdict-text hidden>Sale menos, pero no confirmamos el envío a Argentina</p>
        )}
        {verdict === "amazon" ? (
          <>
            <p class="veredicto" data-verdict-text hidden>Conviene{saving > 0 ? ` · ahorrás ~${formatArs(saving)}` : ""}</p>
            <a class="btn ghost sm" data-buy-link="amazon" data-winner="amazon" href={amazon} {...ext} {...track("amazon", "veredicto")}>
              <span class="cta"><span class="cta-txt"><span data-buy-verb>Ver</span> en Amazon</span><Icon name="arrow-up-right" size={16} /></span>
            </a>
          </>
        ) : (
          <a class="btn ghost sm" data-buy-link="amazon" href={amazon} {...ext} {...track("amazon", "alternativa")}>
            <span class="cta"><span class="cta-txt"><span data-buy-verb>Ver</span> en Amazon</span><Icon name="arrow-up-right" size={16} /></span>
          </a>
        )}
      </div>
    )}

    <a class="costo" href={`/productos/${p.slug}/`}>Ver la cuenta completa</a>
  </div>
</article>
