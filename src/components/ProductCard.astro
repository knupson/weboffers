---
import Icon from "./Icon.astro";
import { amazonUrl, artFor, STORE_LABEL } from "../config";
import { brandLogo } from "../lib/brands";
import { formatArs, formatUsd, formatStamp } from "../lib/format";
import type { CatalogEntry, OfferItem } from "../lib/data";

interface Props {
  product: CatalogEntry & { price: OfferItem | null; offer?: OfferItem };
}

// Una sola tarjeta para todo el catálogo: precio en pesos, veredicto y el botón de compra que conviene.
// El detalle (precio de lista, calculadora, desglose) vive en la ficha.
const { product: p } = Astro.props;
const photo = p.price?.imageUrl ?? p.image ?? null;
const logo = brandLogo(p.brand);
const free = p.shipsToAr?.freeShipping === true;
const amazon = amazonUrl(p.asin, p.store);
const fecha = p.ml?.checked.split("-").reverse().slice(0, 2).join("/");
const verdict = p.ml ? p.verdict ?? "ml" : null;
const track = (tienda: string, origen: string) => ({
  "data-umami-event": tienda === "ml" ? "mercadolibre" : "amazon",
  "data-umami-event-tienda": tienda === "ml" ? "ML" : p.store,
  "data-umami-event-producto": p.slug,
  "data-umami-event-origen": origen,
});
const ext = { target: "_blank", rel: "noopener noreferrer sponsored" };
---

<article class="card" data-category={p.category}>
  <div class="media">
    {photo ? (
      <img class="photo" src={photo} alt="" loading="lazy" />
    ) : (
      <img src={artFor(p)} alt="" loading="lazy" width="900" height="658" />
    )}
    <span class="badge" title={p.brand}>
      {logo ? <svg viewBox={logo.viewBox} style={logo.ratio === 1 ? "height:24px;aspect-ratio:1" : `aspect-ratio:${logo.ratio}`} role="img" aria-label={p.brand}><path d={logo.path} /></svg> : p.brand}
    </span>
    {free && <span class="envio"><Icon name="truck" size={14} /> Envío gratis a Argentina</span>}
  </div>
  <div class="body">
    <h3><a href={`/productos/${p.slug}/`}>{p.name}</a></h3>
    <p class="sum">{p.summary}</p>
  </div>
  <div class="foot">
    {p.price && (
      <p class="precio">
        <span class="lab">En {STORE_LABEL[p.store]}</span>
        <span class="monto num">{formatUsd(p.price.priceUsd as number)}</span>
        <small>al {formatStamp(p.price.priceFetchedAt as string)}</small>
      </p>
    )}
    {p.ml && (
      <p class="precio">
        <span class="lab">En Argentina</span>
        <span class="monto num">{formatArs(p.ml.price)}</span>
        <small>Mercado Libre, {fecha}</small>
      </p>
    )}

    {verdict === "amazon" && (
      <>
        <a class="gana amazon" href={amazon} {...ext} {...track("amazon", "veredicto")}>
          <span class="v">Conviene traerlo</span>
          <span class="cta">Comprar en Amazon <Icon name="arrow-up-right" size={16} /></span>
        </a>
        <a class="alt" href={p.ml!.url} {...ext} {...track("ml", "alternativa")}>o comprarlo en Mercado Libre</a>
      </>
    )}
    {verdict === "ml" && (
      <>
        <a class="gana ml" href={p.ml!.url} {...ext} {...track("ml", "veredicto")}>
          <span class="v">Conviene comprarlo acá</span>
          <span class="cta">Comprar en Mercado Libre <Icon name="arrow-up-right" size={16} /></span>
        </a>
        <a class="alt" href={amazon} {...ext} {...track("amazon", "alternativa")}>o traerlo de Amazon</a>
      </>
    )}
    {!verdict && (
      <a class="btn" href={amazon} {...ext} {...track("amazon", "tarjeta")}>Ver precio en Amazon <Icon name="arrow-up-right" size={16} /></a>
    )}

    <a class="costo" href={`/productos/${p.slug}/`}>Ver la cuenta completa</a>
  </div>
</article>
